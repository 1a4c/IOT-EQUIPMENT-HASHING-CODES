                <!-- Chart 1: Determined Chaos Level -->
                <div class="flex-1 flex flex-col min-h-0">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[11px] font-mono text-cyber-neonRed font-semibold flex items-center gap-1">
