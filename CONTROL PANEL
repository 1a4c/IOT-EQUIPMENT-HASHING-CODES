        /* Tech Cyber Borders & Glows */
        .cyber-border-emerald {
            border: 1px solid rgba(0, 255, 170, 0.3);
            box-shadow: 0 0 12px rgba(0, 255, 170, 0.15);
        }
        .cyber-border-yellow {
            border: 1px solid rgba(255, 220, 0, 0.3);
            box-shadow: 0 0 12px rgba(255, 220, 0, 0.15);
        }
        .cyber-border-purple {
            border: 1px solid rgba(157, 0, 255, 0.3);
            box-shadow: 0 0 12px rgba(157, 0, 255, 0.15);
        }
        .glow-text-green { text-shadow: 0 0 8px rgba(0, 255, 170, 0.6); }
        .glow-text-yellow { text-shadow: 0 0 8px rgba(255, 220, 0, 0.6); }
        .glow-text-cyan { text-shadow: 0 0 8px rgba(0, 229, 255, 0.6); }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: #060913; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 2px; }
        ::-webkit-scrollbar-thumb:hover { background: #00ffaa; }

        /* Scanline HUD effect (pointer-events none to avoid blocking clicks) */
        .scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.25) 50%
            ), linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.03),
                rgba(0, 255, 0, 0.01),
                rgba(0, 0, 255, 0.03)
            );
            background-size: 100% 3px, 6px 100%;
            pointer-events: none !important;
        }

        /* Pulse Animation */
        @keyframes pulse-fast {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .animate-pulse-fast { animation: pulse-fast 1s ease-in-out infinite; }
    </style>
</head>
<body class="h-screen flex flex-col bg-cyber-bg text-slate-200 select-none overflow-hidden relative">

