    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#04070d',
                            panel: '#0b111e',
                            border: '#1a2438',
                            neonGreen: '#00ffaa',
