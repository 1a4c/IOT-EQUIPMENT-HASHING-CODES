        // --- 1. Terminal Logger Function ---
        function addTerminalLog(msg, type = 'info') {
            const terminal = document.getElementById('terminal-logs');
            if (!terminal) return;
            const timestamp = new Date().toTimeString().split(' ')[0];
            
            let color = 'text-slate-300';
            if (type === 'success') color = 'text-cyber-neonGreen';
            if (type === 'warn') color = 'text-cyber-neonYellow';
            if (type === 'error') color = 'text-cyber-neonRed font-semibold';
            if (type === 'cyan') color = 'text-cyber-neonCyan';

            const logRow = document.createElement('div');
            logRow.className = `flex items-start gap-1 ${color}`;
            logRow.innerHTML = `<span class="text-slate-600 font-mono">[${timestamp}]</span> <span>${msg}</span>`;

            terminal.prepend(logRow);
            if (terminal.children.length > 40) terminal.removeChild(terminal.lastChild);
        }

        // --- 2. AST Interactive Render ---
        function renderASTTree() {
            const container = document.getElementById('ast-tree-list');
            if (!container) return;
            container.innerHTML = '';

            astLayersData.forEach((layer, index) => {
                const item = document.createElement('div');
                const indent = Math.min(index * 6, 24); // Visual nesting
                const isActive = layer.id === state.activeLayer;

                item.className = `p-2 rounded border cursor-pointer transition-all ${
                    isActive 
                        ? 'bg-slate-900 border-cyber-neonGreen text-white shadow-md' 
                        : 'bg-slate-950/80 border-slate-800/80 text-slate-400 hover:border-slate-700 hover:text-slate-200'
                }`;
                item.style.marginLeft = `${indent}px`;

                item.innerHTML = `
                    <div class="flex items-center justify-between pointer-events-none">
                        <span class="font-semibold text-[11px] font-mono ${isActive ? 'text-cyber-neonGreen' : 'text-slate-300'}">
                            ${layer.title}
                        </span>
                        <span class="text-[9px] px-1 py-0.2 rounded font-mono ${
                            isActive ? 'bg-cyber-neonGreen/20 text-cyber-neonGreen' : 'bg-slate-800 text-slate-500'
                        }">${layer.tag}</span>
                    </div>
                    <div class="text-[10px] font-mono text-slate-500 truncate mt-0.5 pointer-events-none">${layer.name}</div>
                `;

                item.addEventListener('click', () => {
                    state.activeLayer = layer.id;
                    renderASTTree();
                    updateInspector(layer);
                    addTerminalLog(`切換檢視層級 L${layer.id}: [${layer.name}]`, 'cyan');
                });

                container.appendChild(item);
            });
        }

        function updateInspector(layer) {
            const elName = document.getElementById('inspector-layer-name');
            const elDesc = document.getElementById('inspector-desc');
            const elP1 = document.getElementById('inspector-p1');
            const elP2 = document.getElementById('inspector-p2');
            const elSub = document.getElementById('inspector-subsystem');

            if (elName) elName.innerText = `L${layer.id}: ${layer.name}`;
            if (elDesc) elDesc.innerText = layer.desc;
            if (elP1) elP1.innerText = layer.p1;
            if (elP2) elP2.innerText = layer.p2;
            if (elSub) elSub.innerText = layer.subsystem;
        }

        // --- 3. 3D WebGL Pipeline & Vehicle Simulation (Three.js) ---
        let scene, camera, renderer, pipelineMesh, particlesGroup, vehiclesGroup;

        function init3DSimulation() {
            const wrapper = document.getElementById('canvas-wrapper');
            if (!wrapper) return;
            const width = wrapper.clientWidth || 400;
            const height = wrapper.clientHeight || 300;

            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x04070d, 0.025);

            camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, 5, 22);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(window.devicePixelRatio);
            wrapper.appendChild(renderer.domElement);

            // Lights
            scene.add(new THREE.AmbientLight(0xffffff, 0.5));
            const dirLight = new THREE.DirectionalLight(0x00ffaa, 1.2);
            dirLight.position.set(10, 20, 10);
            scene.add(dirLight);

            const pointLight = new THREE.PointLight(0xffdc00, 2, 40);
            pointLight.position.set(-10, -5, -5);
            scene.add(pointLight);

            // Cylinder Pipeline
            const pipeGeometry = new THREE.CylinderGeometry(2.5, 2.5, 24, 32, 1, true);
            const pipeMaterial = new THREE.MeshPhongMaterial({
                color: 0x00e5ff,
                wireframe: true,
                transparent: true,
                opacity: 0.35,
                side: THREE.DoubleSide
            });
            pipelineMesh = new THREE.Mesh(pipeGeometry, pipeMaterial);
            pipelineMesh.rotation.z = Math.PI / 2;
            scene.add(pipelineMesh);

            // Particles (Helium message flow)
            particlesGroup = new THREE.Group();
            const particleCount = 180;
            const particleGeo = new THREE.SphereGeometry(0.12, 8, 8);
            const particleMat = new THREE.MeshBasicMaterial({ color: 0x00ffaa });

            for (let i = 0; i < particleCount; i++) {
                const mesh = new THREE.Mesh(particleGeo, particleMat);
                mesh.position.set(
                    (Math.random() - 0.5) * 22,
                    (Math.random() - 0.5) * 3.8,
                    (Math.random() - 0.5) * 3.8
                );
                mesh.userData = { speed: 0.1 + Math.random() * 0.15 };
                particlesGroup.add(mesh);
            }
            scene.add(particlesGroup);

            // Orbit Drones (Filing Vehicles)
            vehiclesGroup = new THREE.Group();
            const vehicleGeo = new THREE.BoxGeometry(0.8, 0.5, 1.2);
            const vehicleMat = new THREE.MeshPhongMaterial({
                color: 0xffdc00,
                emissive: 0xffdc00,
                emissiveIntensity: 0.3
            });

            for (let i = 0; i < state.vehiclesCount; i++) {
                const vMesh = new THREE.Mesh(vehicleGeo, vehicleMat);
                const angle = (i / state.vehiclesCount) * Math.PI * 2;
                vMesh.position.set(
                    (i - state.vehiclesCount / 2) * 2.5,
                    Math.sin(angle) * 4.5,
                    Math.cos(angle) * 4.5
                );
                vMesh.userData = { angle: angle, radius: 4.5, speed: 0.02 + Math.random() * 0.01 };
                vehiclesGroup.add(vMesh);
            }
            scene.add(vehiclesGroup);

            // Interactive Drag Controls
            let isDragging = false;
            let prevMousePos = { x: 0, y: 0 };

            renderer.domElement.addEventListener('mousedown', (e) => {
                isDragging = true;
                prevMousePos = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                const deltaX = e.clientX - prevMousePos.x;
                const deltaY = e.clientY - prevMousePos.y;

                pipelineMesh.rotation.y += deltaX * 0.005;
                particlesGroup.rotation.y += deltaX * 0.005;
                vehiclesGroup.rotation.y += deltaX * 0.005;

                pipelineMesh.rotation.x += deltaY * 0.005;
                particlesGroup.rotation.x += deltaY * 0.005;
                vehiclesGroup.rotation.x += deltaY * 0.005;

                prevMousePos = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            window.addEventListener('resize', () => {
                if (!wrapper || !renderer || !camera) return;
                const w = wrapper.clientWidth;
                const h = wrapper.clientHeight;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
            });
        }

        function animate3DSimulation() {
            requestAnimationFrame(animate3DSimulation);

            const chaosFactor = state.isChaosMode ? 2.5 : 1.0;
            if (particlesGroup) {
                particlesGroup.children.forEach(p => {
                    p.position.x += p.userData.speed * (state.hostRate / 400) * chaosFactor;
                    if (state.isChaosMode) {
                        p.position.y += (Math.random() - 0.5) * 0.2;
                    }
                    if (p.position.x > 11) p.position.x = -11;
                });
            }

            if (vehiclesGroup) {
                vehiclesGroup.children.forEach(v => {
                    v.userData.angle += v.userData.speed * (state.hostRate / 600);
                    v.position.y = Math.sin(v.userData.angle) * v.userData.radius;
                    v.position.z = Math.cos(v.userData.angle) * v.userData.radius;
                    v.rotation.x += 0.01;
                });
            }

            if (pipelineMesh) {
                pipelineMesh.rotation.x += 0.002;
            }

            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }

        // --- 4. Dynamic Telemetry Charts (Chart.js) ---
        let chaosChart, cohesiveChart;

        function initCharts() {
            const ctxChaos = document.getElementById('chaosChart')?.getContext('2d');
            if (ctxChaos) {
                chaosChart = new Chart(ctxChaos, {
                    type: 'line',
                    data: {
                        labels: Array(25).fill(''),
                        datasets: [{
                            label: 'Determined Chaos',
                            data: Array(25).fill(0.14),
                            borderColor: '#ff0055',
                            borderWidth: 2,
                            backgroundColor: 'rgba(255, 0, 85, 0.15)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { display: false },
                            y: {
                                min: 0,
                                max: 1.0,
                                grid: { color: 'rgba(30, 41, 59, 0.4)' },
                                ticks: { color: '#64748b', font: { size: 9 } }
                            }
                        }
                    }
                });
            }

            const ctxCohesive = document.getElementById('cohesiveChart')?.getContext('2d');
            if (ctxCohesive) {
                cohesiveChart = new Chart(ctxCohesive, {
                    type: 'bar',
                    data: {
                        labels: ['Copper Align', 'Hole Nicking', 'Rose Slice', 'D-Lock', 'CoAP Seg'],
                        datasets: [{
                            label: 'GFLOPS',
                            data: [98, 88, 92, 95, 90],
                            backgroundColor: [
                                'rgba(0, 255, 170, 0.7)',
                                'rgba(255, 220, 0, 0.7)',
                                'rgba(0, 229, 255, 0.7)',
                                'rgba(157, 0, 255, 0.7)',
                                'rgba(255, 0, 85, 0.7)'
                            ],
                            borderRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: {
                                ticks: { color: '#94a3b8', font: { size: 8 } },
                                grid: { display: false }
                            },
                            y: {
                                max: 120,
                                grid: { color: 'rgba(30, 41, 59, 0.4)' },
                                ticks: { color: '#64748b', font: { size: 9 } }
                            }
                        }
                    }
                });
            }
        }

        // Live Telemetry Update Loop
        setInterval(() => {
            if (chaosChart) {
                const cData = chaosChart.data.datasets[0].data;
                cData.shift();

                let targetChaos = state.isChaosMode ? (0.6 + Math.random() * 0.3) : (0.1 + Math.random() * 0.08);
                cData.push(targetChaos);
                chaosChart.update('none');

                const elVal = document.getElementById('current-chaos-val');
                const elStatus = document.getElementById('top-chaos-status');
                const elDot = document.getElementById('top-chaos-dot');

                if (elVal) elVal.innerText = targetChaos.toFixed(2);
                if (elStatus) {
                    elStatus.innerText = `${targetChaos.toFixed(2)} (${state.isChaosMode ? 'ELEVATED' : 'SUPPRESSED'})`;
                    elStatus.className = state.isChaosMode ? 'text-cyber-neonRed font-semibold' : 'text-cyber-neonGreen font-semibold';
                }
                if (elDot) {
                    elDot.className = `w-2.5 h-2.5 rounded-full ${state.isChaosMode ? 'bg-cyber-neonRed animate-ping' : 'bg-cyber-neonGreen animate-pulse-fast'}`;
                }
            }

            const curSpeed = ((state.hostRate / 450) * (state.isChaosMode ? 0.6 : 1.2)).toFixed(2);
            const elSpeed = document.getElementById('pipeline-speed-text');
            if (elSpeed) elSpeed.innerText = `${curSpeed} GB/s`;
        }, 500);

        // --- 5. Event Binding in DOMContentLoaded ---
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize Lucide Icons
            lucide.createIcons();

            // Clock Interval
            setInterval(() => {
                const clock = document.getElementById('clock-display');
                if (clock) clock.innerText = new Date().toTimeString().split(' ')[0] + ' UTC';
            }, 1000);

            // Startup System Logs
            addTerminalLog("初始化 Layout-Jet & Pipeline 控制台系統...", "cyan");
            addTerminalLog("解析 Pseudo-code 7 層結構成功對齊系統架構", "success");
            addTerminalLog("D-locking 維度鎖定矩陣已錨定就緒", "success");

            // Initialize UI Views & 3D & Charts
            renderASTTree();
            updateInspector(astLayersData[0]);
            init3DSimulation();
            animate3DSimulation();
            initCharts();

            // --- Sliders Listeners ---
            const sliderHost = document.getElementById('slider-host-rate');
            if (sliderHost) {
                sliderHost.addEventListener('input', (e) => {
                    state.hostRate = parseInt(e.target.value);
                    document.getElementById('lbl-host-rate').innerText = `${state.hostRate} ops/s`;
                });
                sliderHost.addEventListener('change', (e) => {
                    addTerminalLog(`調整 scheduling-host 速率至: ${e.target.value} ops/s`, 'info');
                });
            }

            const sliderHelium = document.getElementById('slider-helium-smooth');
            if (sliderHelium) {
                sliderHelium.addEventListener('input', (e) => {
                    state.heliumSmooth = parseFloat(e.target.value);
                    document.getElementById('lbl-helium-smooth').innerText = state.heliumSmooth.toFixed(2);
                });
            }

            // --- Action Buttons Event Bindings ---
            const btnChaosToggle = document.getElementById('btn-toggle-chaos');
            if (btnChaosToggle) {
                btnChaosToggle.addEventListener('click', () => {
                    state.isChaosMode = !state.isChaosMode;
                    btnChaosToggle.innerText = `混沌模式: ${state.isChaosMode ? 'ON' : 'OFF'}`;
                    btnChaosToggle.className = state.isChaosMode 
                        ? 'px-2.5 py-1 bg-cyber-neonRed/20 border border-cyber-neonRed text-cyber-neonRed rounded transition animate-pulse cursor-pointer'
                        : 'px-2.5 py-1 bg-slate-900/90 border border-cyber-neonGreen/50 text-cyber-neonGreen rounded transition cursor-pointer';
                    
                    if (state.isChaosMode) {
                        addTerminalLog('⚠️ 觸發 determined-chaos 狀態，管道數據發生幾何性擾動！', 'error');
                    } else {
                        addTerminalLog('管道混沌壓制重新啟用，回復穩定流動狀態', 'success');
                    }
                });
            }

            const btnSuppress = document.getElementById('btn-suppress-chaos');
            if (btnSuppress) {
                btnSuppress.addEventListener('click', () => {
                    state.isChaosMode = false;
                    if (btnChaosToggle) {
                        btnChaosToggle.innerText = '混沌模式: OFF';
                        btnChaosToggle.className = 'px-2.5 py-1 bg-slate-900/90 border border-cyber-neonGreen/50 text-cyber-neonGreen rounded transition cursor-pointer';
                    }
                    addTerminalLog('觸發 [suppressed-pipeline]！已平抑微瑕疵與混沌擾動', 'success');
                });
            }

            const btnTriggerDLock = document.getElementById('btn-trigger-dlock');
            if (btnTriggerDLock) {
                btnTriggerDLock.addEventListener('click', () => {
                    state.isDLocked = true;
                    const elDlock = document.getElementById('top-dlock-status');
                    if (elDlock) elDlock.innerText = 'ANCHORED';
                    addTerminalLog('執行 D-locking！幾何維度鎖定金鑰已被對齊與固定', 'cyan');
                });
            }

            const btnUrgeCoap = document.getElementById('btn-urge-coap');
            if (btnUrgeCoap) {
                btnUrgeCoap.addEventListener('click', () => {
                    addTerminalLog('發射 Urge-CoAP 廣播：disclosed-core 分段資源已成功曝光至網路', 'warn');
                });
            }

            const btnRecalc = document.getElementById('btn-inspect-recalc');
            if (btnRecalc) {
                btnRecalc.addEventListener('click', () => {
                    addTerminalLog(`重算層級 L${state.activeLayer} 之特徵凝聚張量與算力...`, 'info');
                });
            }

            const btnCopy = document.getElementById('btn-copy-code');
            if (btnCopy) {
                btnCopy.addEventListener('click', () => {
                    const rawCode = "P-coordination.layout-jet[p-q.filing_vehicle.scheduling-host-abide[smooth-pending.helium-cooperated_message[copper_aligned.feature_cohesive-calc[deed-mind.hole_nicking.suppressed-pipeline_determined-chaos.rose-counting.lining_secting-porting_sign.D-locking[system-prospensed.urge-coap.disclosed-core.segmented]]]]]";
                    navigator.clipboard.writeText(rawCode).then(() => {
                        addTerminalLog("Pseudo-code 語法已複製至剪貼簿", "success");
                    });
                });
            }

            const btnClearTerminal = document.getElementById('btn-clear-terminal');
            if (btnClearTerminal) {
                btnClearTerminal.addEventListener('click', () => {
                    const term = document.getElementById('terminal-logs');
                    if (term) term.innerHTML = '';
                    addTerminalLog('Terminal 終端紀錄已清空', 'info');
                });
            }
        });
    </script>
</body>
